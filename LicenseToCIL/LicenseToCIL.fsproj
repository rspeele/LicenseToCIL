<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Authors>Robert Peele</Authors>
    <Description>A library for emitting CIL using F# computation expressions.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright 2016 Robert Peele</Copyright>
    <PackageTags>fsharp f# cil msil il emit reflection</PackageTags>
    <PackageProjectUrl>https://github.com/rspeele/LicenseToCIL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rspeele/LicenseToCIL</RepositoryUrl>
    <PackageReleaseNotes>Target netstandard2.0 and net8.0; bump FSharp.Core.</PackageReleaseNotes>
    <Version>1.1.0</Version>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Stack.fs" />
    <Compile Include="IL.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Ops.fsi" />
    <Compile Include="Ops.fs" />
    <Compile Include="CILBuilder.fs" />
    <Compile Include="Switch.fs" />
    <Compile Include="StringSwitch.fs" />
    <Compile Include="Delegates.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.401" />
  </ItemGroup>

  <!-- TypeBuilder / DynamicMethod / LocalBuilder are not in the netstandard2.0 BCL surface,
       so we still need the System.Reflection.Emit reference packages for that target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

</Project>
